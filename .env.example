# =============================================================================
# Multi-Agent Local LLM Swarm — environment template
# =============================================================================
# Copy to `.env` (gitignored) and replace the placeholders:
#   cp .env.example .env
# Every value below is a placeholder; none is a working credential. The
# orchestrator token is a local development value and must be rotated before
# the task API is reachable from anything but loopback.

# --- Local inference backend (Ollama by default, vLLM OpenAI-compatible) -----
# Inside Compose the base URL is the service name; outside it is loopback.
SWARM_LLM_BASE_URL=http://llm-runtime:11434
SWARM_LLM_MODEL=qwen2.5:3b-instruct
# Ollama needs no key by default. Set one only behind an authenticating proxy.
SWARM_LLM_API_KEY=replace-with-local-llm-api-key-if-proxied
SWARM_LLM_TIMEOUT_SECONDS=120

# --- Orchestrator control plane ---------------------------------------------
# Required by the worker; the task API rejects requests without it.
SWARM_ORCHESTRATOR_TOKEN=replace-with-local-orchestrator-token
SWARM_SERVER_PORT=8080
SWARM_PORT=8090

# --- Agent operational parameters -------------------------------------------
SWARM_MAX_AGENTS=4
SWARM_MAX_STEPS=12
SWARM_TASK_TIMEOUT_SECONDS=300
SWARM_TEMPERATURE=0.2
SWARM_CONFIG_DIR=/app/configs
SWARM_STATE_DIR=/app/state

# --- Inference server tuning ------------------------------------------------
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=2
OLLAMA_MEM_LIMIT=12g
OLLAMA_CPUS=6

# --- Worker resource envelope ----------------------------------------------
WORKER_MEM_LIMIT=2g
WORKER_CPUS=2

# --- Runtime -----------------------------------------------------------------
LOG_LEVEL=INFO
TZ=UTC
